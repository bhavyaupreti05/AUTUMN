# Environment and authentication
ENVIRONMENT=development
JWT_SECRET=replace-with-a-new-64-character-random-hex-secret
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Settings
API_HOST=127.0.0.1
API_PORT=8000

# RAG Configuration
# Controls whether document embeddings are generated and inserted into ChromaDB.
# If true, uploaded PDFs will be vectorized and searchable by the LLM.
RAG_ENABLED=true

# Document processing limits
MAX_PDF_SIZE_MB=15
MAX_DOCUMENT_PAGES=500
MAX_EXTRACTED_TEXT_MB=50
MAX_DOCX_UNCOMPRESSED_MB=100

# Model Settings
# Path to local model if already downloaded, or it will download automatically
MODEL_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF
MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# CPU Inference (adjust based on your physical cores)
CPU_THREADS=4

# Generation settings
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=512
