# Copy to /opt/chatbot-2/.env; never commit the populated file.
# Deployment mode must remain production on the server.
ENVIRONMENT=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Never replace this placeholder with a committed secret.
JWT_SECRET=<generate-a-new-64-character-hex-secret>
# Required for HTTPS deployments; use false only for a private HTTP smoke test.
COOKIE_SECURE=true
# Exact browser HTTPS origin, including scheme and non-default port when present.
ALLOWED_ORIGINS=https://chat.example.com
# One workday; lower this for stricter security.
ACCESS_TOKEN_EXPIRE_MINUTES=480
PASSWORD_RESET_TTL_MINUTES=30

API_HOST=127.0.0.1
API_PORT=8000
SINGLE_WORKER_CONFIRMED=true

DATABASE_URL=/opt/chatbot-2/data/chatbot.db
CHROMA_DB_PATH=/opt/chatbot-2/data/chroma
DOCUMENTS_DIR=/opt/chatbot-2/data/documents
RAG_ENABLED=true
