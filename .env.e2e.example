# Playwright E2E Testing Environment Variables
# Do NOT place real production or development secrets here.
# Create this file with: copy .env.e2e.example .env.e2e

# Test user credentials (seeded automatically before tests)
TEST_USERNAME="e2e_test_user"
TEST_PASSWORD="e2e_test_password"
E2E_ADMIN_USERNAME="e2e_admin_user"
E2E_ADMIN_PASSWORD="E2E-Admin-Password-1"

# E2E App Configuration
# We isolate the database and vector store so we don't pollute dev environments
DATABASE_URL="data/chatbot_e2e.db"
CHROMA_DB_PATH="data/chroma_e2e"

# Backend configuration for E2E
API_PORT=8001
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"
# Generate a valid secret with:
# python -c "import secrets; print(secrets.token_hex(32))"

# Vite frontend configuration for E2E
PORT=5174
VITE_API_URL="http://localhost:8001"
