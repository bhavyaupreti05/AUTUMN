[Unit]
Description=ChatBot-2 FastAPI Application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/chatbot-2
Environment="PATH=/opt/chatbot-2/venv/bin"
EnvironmentFile=/opt/chatbot-2/.env
Environment="SINGLE_WORKER_CONFIRMED=true"
ExecStart=/opt/chatbot-2/venv/bin/uvicorn src.api.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=chatbot-2

[Install]
WantedBy=multi-user.target
